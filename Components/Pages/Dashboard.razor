@page "/"
@using MudBlazor

<MudText Typo="Typo.h4" GutterBottom="true">Dashboard</MudText>

<MudGrid Spacing="3">
    <!-- Current Streak -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="4" Class="pa-4 rounded-xl streak-card">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" class="dashbaord-color">
                        Current Streak
                    </MudText>

                    <MudText Typo="Typo.h3" Class="fw-bold dashbaord-color">
                        5 <span class="streak-fire">🔥</span>
                    </MudText>
                </MudStack>

                <MudAvatar Size="Size.Large" Class="streak-icon">
                    <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" />
                </MudAvatar>

            </MudStack>
        </MudPaper>
    </MudItem>

    <!-- Longest Streak -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="4" Class="pa-4 rounded-xl longest-card">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="dashbaord-color">
                        Longest Streak
                    </MudText>

                    <MudText Typo="Typo.h3" Class="fw-bold dashbaord-color">
                        12
                    </MudText>
                </MudStack>

                <MudAvatar Size="Size.Large" Class="stat-icon trophy">
                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" />
                </MudAvatar>

            </MudStack>
        </MudPaper>
    </MudItem>


    <!-- Most Frequent Mood -->

     <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="4" Class="pa-4 rounded-xl mood-card">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="dashbaord-color">
                        Most Frequent Mood
                    </MudText>

                    <MudText  Class="fw-bold dashbaord-color">
                        Happy
                    </MudText>
                </MudStack>

                <MudAvatar Size="Size.Large" Class="stat-icon trophy">
                    <MudIcon Icon="@Icons.Material.Filled.Mood" />
                </MudAvatar>

            </MudStack>
        </MudPaper>
    </MudItem>


    <!-- Total Journals -->
   <MudItem xs="12" sm="6" md="3">
    <MudPaper Elevation="4" Class="pa-4 rounded-xl total-card">
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle2" Class="dashbaord-color">
                    Total Entries
                </MudText>

                <MudText Typo="Typo.h3" Class="fw-bold dashbaord-color">
                    48
                </MudText>
            </MudStack>

            <MudAvatar Size="Size.Large" Class="stat-icon book">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
            </MudAvatar>

        </MudStack>
    </MudPaper>
</MudItem>

</MudGrid>

<MudDivider Class="my-6" />

<MudGrid Spacing="3">
   
    <!-- Mood Distribution -->
    <MudItem xs="12" md="6">
        <MudPaper Elevation="4" Class="pa-4 rounded-xl analytics-card">
            <MudStack Spacing="2">

                <!-- Header -->
                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                    <MudAvatar Class="analytics-icon mood-chart">
                        <MudIcon Icon="@Icons.Material.Filled.PieChart" />
                    </MudAvatar>

                    <MudText Typo="Typo.h6" Class="fw-bold">
                        Mood Distribution
                    </MudText>
                </MudStack>

                <MudDivider />

                <!-- Placeholder Content -->
                <MudStack AlignItems="AlignItems.Center"
                          Justify="Justify.Center"
                          Class="analytics-placeholder">

                    <MudIcon Icon="@Icons.Material.Filled.InsertChart"
                             Size="Size.Large"
                             Color="Color.Secondary" />

                    <MudText Color="Color.Secondary">
                        Chart will be added here
                    </MudText>

                </MudStack>

            </MudStack>
        </MudPaper>
    </MudItem>

    <!-- Word Count Trend Placeholder -->
    <MudItem xs="12" md="6">
        <MudPaper Elevation="4" Class="pa-4 rounded-xl analytics-card">
            <MudStack Spacing="2">

                <!-- Header -->
                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                    <MudAvatar Class="analytics-icon word-chart">
                        <MudIcon Icon="@Icons.Material.Filled.ShowChart" />
                    </MudAvatar>

                    <MudText Typo="Typo.h6" Class="fw-bold">
                        Word Count Trend
                    </MudText>
                </MudStack>

                <MudDivider />

                <!-- Placeholder Content -->
                <MudStack AlignItems="AlignItems.Center"
                          Justify="Justify.Center"
                          Class="analytics-placeholder">

                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp"
                             Size="Size.Large"
                             Color="Color.Secondary" />

                    <MudText Color="Color.Secondary">
                        Chart will be added here
                    </MudText>

                </MudStack>

            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>